# ============================================================
# VERCEL / ÜRETİM İÇİN ZORUNLU DEĞİŞKENLER
#   PAYLOAD_SECRET  → yoksa build "missing secret key" ile düşer
#   DATABASE_URI    → postgres:// olmalı; Vercel'de dosya tabanlı
#                     SQLite ÇALIŞMAZ (dosya sistemi geçici/salt-okunur)
#   BLOB_READ_WRITE_TOKEN → yoksa ürün görselleri üretimde görünmez
# ============================================================

# --- Veritabanı ---
# Yerel geliştirmede SQLite (dosya). Üretimde Postgres (Neon) bağlantı adresi yazın.
# Neon'un Vercel entegrasyonu kuruluysa DATABASE_URL adıyla gelir; kod onu da okur.
DATABASE_URI=file:./miskhane.db
# Üretim örneği:
# DATABASE_URI=postgres://kullanici:sifre@host/veritabani?sslmode=require

# --- Payload gizli anahtarı ---
# Uzun ve rastgele bir dize olmalı. Üretim ve geliştirmede FARKLI olmalı.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Sitenin genel adresi (canonical URL, sitemap, metadata için) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Görsel deposu (üretim / Vercel Blob) — yereldeyken boş bırakın ---
# Doldurulunca görseller yerel disk yerine Vercel Blob'a yüklenir.
# Vercel, projeye Blob store bağlandığında bu değişkeni kendisi ekler.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
