# --- Veritabanı ---
# Yerel geliştirmede SQLite (dosya). Üretimde Postgres (Neon) bağlantı adresi yazın.
DATABASE_URI=file:./miskhane.db
# Üretim örneği:
# DATABASE_URI=postgres://kullanici:sifre@host/veritabani?sslmode=require

# --- Payload gizli anahtarı ---
# Uzun ve rastgele bir dize olmalı. Üretim ve geliştirmede FARKLI olmalı.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Sitenin genel adresi (canonical URL, sitemap, metadata için) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Görsel deposu (üretim / Cloudflare R2) — yereldeyken boş bırakın ---
# Doldurulunca görseller yerel disk yerine buluta yüklenir.
# S3_BUCKET=miskhane-media
# S3_ENDPOINT=https://<hesap-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
