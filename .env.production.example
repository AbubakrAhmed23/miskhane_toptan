# Üretim (Vercel) veritabanına ve bulut deposuna ürünleri aktarmak için.
# Bu dosyayı `.env.production` olarak kopyalayıp doldurun — ASLA commit etmeyin.
#
# Kullanım:  npm run import:prod
#
# Betik yerel `media/ürünler/` klasöründeki 240 görseli okur, R2/S3'e yükler ve
# ürün kayıtlarını Postgres'e yazar. Görseller yeniden kodlanmaz.

# Vercel'deki ile AYNI olmalı
DATABASE_URI=postgres://kullanici:sifre@host/veritabani?sslmode=require
PAYLOAD_SECRET=vercel-ile-ayni-uzun-rastgele-dize
NEXT_PUBLIC_SERVER_URL=https://alan-adiniz.vercel.app

# Cloudflare R2 (veya S3) — bunlar olmadan görseller üretimde görünmez
S3_BUCKET=miskhane-media
S3_ENDPOINT=https://<hesap-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
